export ONE_LOOP_START_LAYER=3
export ONE_LOOP_BASE_FULL_NEXT_LAYER=4
export SEED_CACHE_GIB=4
export FULL_MDP_RAM_NEXT_LAYER=0
export FULL_MDP_RAM_NEXT_LAYER_MAX_GIB=8
export FULL_MDP_RAM_PAIR_MAX_GIB=8
export FULL_MDP_MMAP_SPILL=1
export FULL_MDP_BLOCK_CHUNK=128
export FULL_MDP_BATCH_CHUNKS=24
export ONE_LOOP_MDP_BATCH_CHUNKS=24
export FULL_MDP_LOOKUP_GROUP_CHUNKS=1
export FULL_MDP_RAM_DENSE_MIN_COUNT=0
