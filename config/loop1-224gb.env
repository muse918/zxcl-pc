# Archived capacity-planning profile; NOT used for current experiments.
# The user currently limits experiments to 32 GiB RAM, 4 CPUs and 32 GiB combined
# outputs/scratch. This profile exceeds those limits and must remain unused.
# Read docs/LOOP1_FULL_SWEEP.md for the current experiment runner. This assumes a
# 251 GiB host with sufficient available memory and no tighter cgroup limit.
# These are heap-planner allowances, not a hard process/RSS limit.
source "$(dirname "${BASH_SOURCE[0]}")/reference-128gb.env"

# 176 GiB remains after the reserve. The current dataset's largest adjacent
# f32 pair is 154.027 GiB, leaving room for bounded workers and lookup caches.
# Keep the reference profile and its public pipeline defaults unchanged.
export FULL_MDP_MEMORY_MAX_GIB=224
export FULL_MDP_MEMORY_RESERVE_GIB=48
export FULL_MDP_RAM_PAIR_MAX_GIB=160
export FULL_MDP_RAM_NEXT_LAYER_MAX_GIB=160
